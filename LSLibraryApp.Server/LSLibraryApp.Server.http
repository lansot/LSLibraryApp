Content-Type: application/json

{
  "title": "test topic bababbababa",
  "body": "",
  "tags": [ {"name": "test tag" } ],
  "version": 1
}

###

PUT {{LSLibraryApp.Server_HostAddress}}/topics/6
Content-Type: application/json

{
  "id": 6,
  "title": "test topic bababbababa",
  "body": "",
  "tags": [
    {
      "name": "yeah"
    },
    {
      "name": "getting-started"
    }
  ],
  "version": 1
}

